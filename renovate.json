{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "flux": {
    "managerFilePatterns": ["/flux/.+\\.yaml$/"]
  },
  "nix": {
    "enabled": true
  },
  "kubernetes": {
    "managerFilePatterns": ["/flux/.+\\.yaml$/"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "recreateWhen": "always",
    "branchTopic": "lock-file-maintenance",
    "schedule": ["before 4am on monday"]
  }
}
