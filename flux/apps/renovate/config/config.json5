{
    "$schema": "https://docs.renovatebot.com/renovate-global-schema.json",
    // Set this to true to allow cloning custom Cargo git registries. This only restricts non-sparse registries.
    "allowCustomCrateGitRegistries": true,

    // Set this to true if repositories are allowed to run install scripts.
    "allowScripts": true,

    // Whether to run commands for postUpgradeTasks inside a shell. 
    // This has security implications, as it means that they can call out to other commands or access shell variables.
    // It is difficult to craft an allowedCommands regex to restrict this.
    "allowShellExecutorForPostUpgradeCommands": true,

    // List of possibly unsafe executions which are permitted to run. 
    // This enables global control over any implicit commands which are run as part of a renovate run. 
    // This is similar to allowedCommands but is specifically used to control executions which run automatically, and are not explicitly added in postUpgradeTasks
    "allowedUnsafeExecutions": ["goGenerate", "gradleWrapper", "mise"],

    // Autodiscover all repositories.
    "autodiscover": true,

    // The sort method for autodiscover server side repository search.
    "autodiscoverRepoSort": "updated_at",

    // Controls how third-party tools like npm or Gradle are called: directly, via Docker sidecar containers, or via dynamic install.
    "binarySource": "install",

    // Cache private packages in the datasource cache. This is useful for self-hosted setups
    "cachePrivatePackages": true,

    // Exit with an error-specific exit code when a repository run ends in a known error state.
    "exitCodeForErrors": true,

    // Whether Renovate may make HTTP requests to internal hosts, such as loopback, private-range and link-local addresses. 
    // warn logs the requests which block would refuse.
    "internalHostAccess": "block",

    // If set to true: keep repository data between runs instead of deleting the data.
    "persistRepoData": true,

    // Platform type of repository.
    "platform": "github",

    // This option decides if Renovate uses a JSON cache to speed up extractions.
    "repositoryCache": "enabled"
}