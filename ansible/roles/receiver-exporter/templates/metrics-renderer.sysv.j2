#!/bin/sh
### BEGIN INIT INFO
# Provides:          home-metrics-renderer
# Required-Start:    $network
# Required-Stop:     $network
# Should-Start:      $remote_fs
# Should-Stop:       $remote_fs
# Default-Start:     3
# Default-Stop:      0 1 6
# Short-Description: Temporary home metrics renderer heartbeat
### END INIT INFO

NAME=home-metrics-renderer
DAEMON=/usr/bin/python3
SCRIPT=/opt/home-monitoring/metrics-renderer.py
PIDFILE=/var/run/$NAME.pid
ARGS="--heartbeat /var/lib/home-monitoring/renderer-success --interval-seconds {{ receiver_renderer_interval_seconds }}"

case "$1" in
    start)
        echo "Starting $NAME"
        start-stop-daemon --start --background --make-pidfile --pidfile "$PIDFILE" \
            --exec "$DAEMON" -- "$SCRIPT" $ARGS
        ;;
    stop)
        echo "Stopping $NAME"
        if [ -f "$PIDFILE" ]; then
            kill "$(cat "$PIDFILE")" 2>/dev/null || true
            rm -f "$PIDFILE"
        fi
        ;;
    restart|force-reload)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    status)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "$NAME is running"
            exit 0
        fi
        echo "$NAME is not running"
        exit 3
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|force-reload|status}" >&2
        exit 2
        ;;
esac

exit 0
